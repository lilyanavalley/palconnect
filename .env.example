# Discord Bot Token - Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# PalWorld Dedicated Server REST API URL (single-server legacy mode only)
# If you define [[palworld_servers]] in Config.toml, these variables are ignored.
PALWORLD_API_URL=http://localhost:8212

# PalWorld Server Admin Password (single-server legacy mode only)
PALWORLD_ADMIN_PASSWORD=your_admin_password_here

# Enable multi-tenant mode (true/false, default: false)
# false = self-hosted single-guild mode, reads config from Config.toml
# true  = hosted multi-guild mode, requires DATABASE_URL and CREDENTIAL_MASTER_KEY
MULTI_TENANT=false

# Allow new guild invites (multi-tenant mode only, true/false, default: true)
INVITE_ENABLED=true

# Enable auto updating? (true/false, default: false)
UPDATES_AUTO_ENABLE=false

# Status update interval in seconds (default: 30)
STATUS_UPDATE_INTERVAL=30

# Discord channel ID for the live pinned server-status message (optional).
# When set, the bot posts and pins a status embed in this channel and edits it
# on every poll.  Can also be set at runtime with /set_status_channel.
# STATUS_CHANNEL_ID=123456789012345678
